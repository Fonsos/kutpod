# Puerto en el que escucha KutPod en el servidor
KUTPOD_PORT=8080
# Usuario/grupo con el que corre (Unraid: 99 y 100)
PUID=33
PGID=33
TZ=Europe/Madrid
# Solo con docker-compose.imagen.yml: etiqueta de la imagen (latest, 1.2.33, edge)
KUTPOD_TAG=latest
# Solo al construir: 1 = incluir faster-whisper (plugin Estudio; ~1 GB más)
WITH_WHISPER=0
